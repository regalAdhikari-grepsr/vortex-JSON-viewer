{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vortex-JSON-viewer",
  "version": "0.1.0",
  "identifier": "com.regal.vortex-JSON-viewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "vortex-JSON-viewer",
      "width": 1250,
      "height": 600
    }],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}